<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>عيادة د. محمد إسماعيل - استشاري النساء والولادة</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, "Segoe UI", Tahoma, Arial, sans-serif;
        }
        body {
            background-color: #09090b;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(212, 175, 55, 0.16) 0%, transparent 45%),
                radial-gradient(circle at 85% 85%, rgba(212, 175, 55, 0.12) 0%, transparent 45%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            color: #ffffff;
            -webkit-tap-highlight-color: transparent;
        }
        .glass-card {
            width: 100%;
            max-width: 410px;
            background: rgba(24, 24, 27, 0.72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 32px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85), 0 0 25px rgba(212, 175, 55, 0.08);
        }
        .top-glow {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 75%;
            height: 3px;
            background: linear-gradient(90deg, transparent, #D4AF37, transparent);
            opacity: 0.75;
        }
        .header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .badge-clinic {
            font-size: 12px;
            color: #d4d4d8;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #D4AF37;
            display: inline-block;
            box-shadow: 0 0 8px #D4AF37;
        }
        .share-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #e4e4e7;
            font-size: 12px;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 999px;
            cursor: pointer;
            transition: 0.2s;
        }
        .share-btn:hover, .share-btn:active {
            background: rgba(255, 255, 255, 0.12);
            transform: scale(0.97);
        }
        .profile-section {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .avatar-wrapper {
            position: relative;
            margin-bottom: 16px;
        }
        .avatar-img {
            width: 112px;
            height: 112px;
            border-radius: 50%;
            object-fit: cover;
            object-position: center top;
            border: 2px solid #18181b;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.45), 0 0 20px rgba(212, 175, 55, 0.25);
        }
        .verified-badge {
            position: absolute;
            bottom: 2px;
            right: 2px;
            background: #18181b;
            border-radius: 50%;
            width: 26px;
            height: 26px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .doc-name {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 4px;
        }
        .doc-title {
            font-size: 14px;
            font-weight: 700;
            background: linear-gradient(to left, #FDE047, #D4AF37);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }
        .slogan-pill {
            background: rgba(212, 175, 55, 0.12);
            border: 1px solid rgba(212, 175, 55, 0.35);
            border-radius: 999px;
            padding: 5px 16px;
            margin-bottom: 12px;
            font-size: 12px;
            font-weight: 700;
            color: #FACC15;
        }
        .address-box {
            font-size: 12px;
            color: #d4d4d8;
            line-height: 1.6;
            max-width: 340px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .actions-section {
            margin-top: 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .vcard-btn {
            width: 100%;
            background: linear-gradient(135deg, #D4AF37 0%, #F3E5AB 50%, #AA820A 100%);
            background-size: 200% auto;
            color: #09090b;
            font-weight: 800;
            font-size: 16px;
            padding: 14px 20px;
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 20px -5px rgba(212, 175, 55, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: 0.3s;
        }
        .vcard-btn:hover, .vcard-btn:active {
            background-position: right center;
            transform: scale(0.98);
        }
        .quick-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }
        .quick-btn {
            text-decoration: none;
            color: #ffffff;
            font-weight: 700;
            font-size: 12px;
            padding: 12px 8px;
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: 0.2s;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .quick-btn:hover, .quick-btn:active {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(0.96);
        }
        .quick-btn.whatsapp {
            background: rgba(37, 211, 102, 0.14);
            border-color: rgba(37, 211, 102, 0.32);
        }
        .quick-btn.whatsapp:hover {
            background: rgba(37, 211, 102, 0.22);
        }
        .footer {
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            font-size: 11px;
            color: #a1a1aa;
        }
        .toast {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #18181b;
            border: 1px solid rgba(212, 175, 55, 0.5);
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: 999px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.8);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 50;
            white-space: nowrap;
        }
        .toast.show {
            opacity: 1;
        }
    </style>
</head>
<body>

    <main class="glass-card">
        <div class="top-glow"></div>

        <div class="header-bar">
            <span class="badge-clinic">
                <span class="pulse-dot"></span>
                الحماية المتكاملة
            </span>
            <button onclick="shareCard()" class="share-btn">
                <span>مشاركة الكارت</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="5" r="3"></circle>
                    <circle cx="6" cy="12" r="3"></circle>
                    <circle cx="18" cy="19" r="3"></circle>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
            </button>
        </div>

        <div class="profile-section">
            <div class="avatar-wrapper">
                <img src="data:image/png;base64," alt="د. محمد إسماعيل" class="avatar-img">
                <div class="verified-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#D4AF37">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                </div>
            </div>

            <h1 class="doc-name">د. محمد إسماعيل</h1>
            <p class="doc-title">استشاري النساء و الولادة - الحماية المتكاملة</p>
            <div class="slogan-pill">« انتي حامل ... مش عيانة »</div>

            <div class="address-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>مدينة السادات - سوق المنطقة الأولى، أمام صيدلية مصر</span>
            </div>
        </div>

        <div class="actions-section">
            <button onclick="downloadVCard()" class="vcard-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#09090b" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                <span>حفظ جهة الاتصال</span>
            </button>

            <div class="quick-grid">
                <a href="tel:+201002383946" class="quick-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                    <span>اتصال</span>
                </a>

                <a href="https://wa.me/201002383946?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20%D8%B9%D9%8A%D8%A7%D8%AF%D8%A9%20%D8%AF.%20%D9%85%D8%AD%D9%85%D8%AF%20%D8%A5%D8%B3%D9%85%D8%A7%D8%B9%D9%8A%D9%84%D8%8C%20%D8%A3%D8%B1%D8%BA%D8%A8%20%D9%81%D9%8A%20%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1%20%D8%B9%D9%86%20%D9%85%D9%88%D8%A7%D8%B9%D9%8A%D8%AF%20%D8%A7%D9%84%D8%AD%D8%AC%D8%B2" target="_blank" class="quick-btn whatsapp">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                    <span>واتساب</span>
                </a>

                <a href="https://www.google.com/maps/search/?api=1&query=مدينة+السادات+سوق+المنطقة+الأولى+أمام+صيدلية+مصر" target="_blank" class="quick-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                        <line x1="8" y1="2" x2="8" y2="18"></line>
                        <line x1="16" y1="6" x2="16" y2="22"></line>
                    </svg>
                    <span>الموقع</span>
                </a>
            </div>
        </div>

        <div class="footer">
            عيادة الحماية المتكاملة • 01002383946
        </div>
    </main>

    <div id="toast" class="toast">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span id="toast-msg">تمت العملية بنجاح</span>
    </div>

    <script>
        const contactData = {
            firstName: "محمد",
            lastName: "إسماعيل",
            fullName: "د. محمد إسماعيل - نساء وتوليد",
            organization: "عيادة الحماية المتكاملة",
            title: "استشاري النساء و الولادة",
            phone: "+201002383946",
            address: "مدينة السادات - سوق المنطقة الأولى، أمام صيدلية مصر",
            note: "انتي حامل ... مش عيانة"
        };

        function downloadVCard() {
            const vcard = [
                "BEGIN:VCARD",
                "VERSION:3.0",
                `N;CHARSET=UTF-8:${contactData.lastName};${contactData.firstName};;;`,
                `FN;CHARSET=UTF-8:${contactData.fullName}`,
                `ORG;CHARSET=UTF-8:${contactData.organization}`,
                `TITLE;CHARSET=UTF-8:${contactData.title}`,
                `TEL;TYPE=CELL,VOICE:${contactData.phone}`,
                `ADR;TYPE=WORK;CHARSET=UTF-8:;;${contactData.address};;;;`,
                `NOTE;CHARSET=UTF-8:${contactData.note}`,
                "END:VCARD"
            ].join("\n");

            const blob = new Blob([vcard], { type: "text/vcard;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            
            const link = document.createElement("a");
            link.href = url;
            link.setAttribute("download", "د_محمد_اسماعيل.vcf");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);

            showToast("تم تحميل بيانات العيادة بنجاح");
        }

        async function shareCard() {
            const shareData = {
                title: contactData.fullName,
                text: `${contactData.fullName} - ${contactData.title}\nالعنوان: ${contactData.address}`,
                url: window.location.href
            };

            if (navigator.share) {
                try {
                    await navigator.share(shareData);
                } catch (err) {}
            } else if (navigator.clipboard) {
                navigator.clipboard.writeText(window.location.href);
                showToast("تم نسخ رابط الكارت للحافظة");
            }
        }

        function showToast(message) {
            const toast = document.getElementById("toast");
            const toastMsg = document.getElementById("toast-msg");
            toastMsg.textContent = message;
            toast.classList.add("show");
            setTimeout(() => {
                toast.classList.remove("show");
            }, 3000);
        }
    </script>
</body>
</html>
